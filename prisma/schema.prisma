  @@unique([userId, lessonSlug])
  @@index([userId])
}

model AutoScalpConfig {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled       Boolean   @default(false)
  minScore      Int       @default(72)
  minConfidence Int       @default(3)
  maxPerDay     Int       @default(5)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  symbols AutoScalpSymbol[]

  @@index([enabled])
}

model AutoScalpSymbol {
  id          String    @id @default(cuid())
  configId    String
  symbol      String
  enabled     Boolean   @default(true)
  lotSize     Float     @default(0.01)
  /// Thời điểm giao dịch auto-scalp cuối cùng của symbol này (cooldown 30 phút)
  lastTradeAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  config AutoScalpConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, symbol])
  @@index([configId, enabled])
}

model ScreenerLotConfig {
  id        String   @id @default(cuid())
  /// Real symbol (e.g. "XAUUSD") or the "DEFAULT" sentinel — fallback lot size used
  /// for any symbol without its own row. Admin-managed at /admin/crons/lot-sizes.
  symbol    String   @unique
  lotSize   Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  symbol      String
  targetPrice Float
  /// "ABOVE" | "BELOW"
  direction   String
  isActive    Boolean   @default(true)
  /// Recurring alerts stay active and re-fire on each threshold cross
  isRecurring     Boolean @default(false)
  /// Minimum minutes between two fires of a recurring alert
  cooldownMinutes Int     @default(15)
  /// Recurring only: false after a fire until price returns past the threshold
  armed           Boolean @default(true)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive, symbol])
  @@index([userId])
}

model AiWeeklyJournalReview {
  id         String   @id @default(cuid())
  userId     String
  /// Thứ Hai 00:00 UTC của tuần
  weekStart  DateTime
  /// Chủ Nhật 23:59:59 UTC của tuần
  weekEnd    DateTime
  tradeCount Int
  /// AiJournalAnalysis JSON
  analysis   Json
  locale     String   @default("vi")
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

model AiDailyJournalReview {
  id         String   @id @default(cuid())
  userId     String
