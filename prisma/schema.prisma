// Social Forex — Prisma schema (Auth.js + community features)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MOD
  ADMIN
}

enum SignalTier {
  FREE
  VIP
}

enum SignalStatus {
  PENDING
  ACTIVE
  CLOSED_WIN
  CLOSED_LOSS
  CANCELLED
}

enum Mt5SignalKind {
  PENDING_ORDER
  OPEN_POSITION
}

enum VipPaymentStatus {
  CREATED
  CAPTURED
  FULFILLED
  FAILED
}

enum AiArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  locale        String    @default("vi")
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  bio           String?
  role          UserRole  @default(USER)
  vipUntil      DateTime?

  accounts Account[]
  sessions Session[]

  followingFollows UserFollow[] @relation("UserFollowing")
  followerFollows  UserFollow[] @relation("UserFollowers")

  threads ForumThread[]
  posts   ForumPost[]
  signals Signal[]

  sentMessages         DirectMessage[]      @relation("SentMessages")
  receivedMessages     DirectMessage[]      @relation("ReceivedMessages")
  forumReports         ForumReport[]        @relation("ForumReporter")
  favoriteSymbols      UserFavoriteSymbol[]
  signalComments       SignalComment[]
  signalReactions      SignalReaction[]
  tradeJournals        TradeJournal[]
  emotionDiaryEntries  EmotionDiaryEntry[]
  journalLessons       JournalLesson[]
  notifications        Notification[]       @relation("NotificationRecipient")
  notificationsAsActor Notification[]       @relation("NotificationActor")
  signalEditLogs       SignalEditLog[]
  pinnedSignals        UserPinnedSignal[]
  vipPayments          VipPayment[]
  demoChallenges       UserDemoChallenge[]
  dailyTradingPlans    DailyTradingPlan[]
  mt5Connections       Mt5Connection[]
  pageVisits           UserPageVisit[]
  clientErrors         UserClientError[]
  funnelEvents         FunnelEvent[]
  screenerAlerts       ScreenerAlert[]

  /// Thông báo in-app: tín hiệu từ trader đang follow
  notifySignalFollow       Boolean @default(true)
  /// Thông báo khi có tín hiệu trùng symbol trong watchlist (favorites)
  notifySignalFavoriteSym  Boolean @default(true)
  /// (VIP) Thông báo khi có tín hiệu VIP mới trên nền tảng
  notifySignalVipBroadcast Boolean @default(false)

  streakJournal        Int       @default(0)
  streakPlan           Int       @default(0)
  streakSignal         Int       @default(0)
  lastJournalDate      DateTime?
  lastPlanDate         DateTime?
  lastSignalDate       DateTime?
  notifyStreakReminder Boolean   @default(true)

  xp                   Int       @default(0)
  /// Set when the one-time onboarding checklist XP bonus was claimed
  onboardingBonusAt    DateTime?

  /// Mã referral duy nhất (8 ký tự)
  referralCode         String?   @unique
  /// User đã giới thiệu (referral)
  referredById         String?
  referredBy           User?     @relation("ReferralInvite", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers        User[]    @relation("ReferralInvite")
  referralRewardsGiven ReferralEvent[] @relation("ReferralRewardReferrer")
  referralRewardsEarned ReferralEvent[] @relation("ReferralRewardReferee")
  pushSubscriptions    UserPushSubscription[]
  copyTradesAsFollower CopyTrade[] @relation("CopyTradeFollower")
  copyTradesAsProvider CopyTrade[] @relation("CopyTradeProvider")
  copyTradeReviewsGiven    CopyTradeReview[] @relation("CopyTradeReviewReviewer")
  copyTradeReviewsReceived CopyTradeReview[] @relation("CopyTradeReviewProvider")
  /// Trader tạm dừng copy-trade — lệnh MT5 mới vẫn tạo Signal nhưng không bắn cho copier/Telegram
  copyTradingPaused    Boolean     @default(false)
  hostedWebinars       Webinar[]
  webinarRegistrations WebinarRegistration[]
  aiTradeProposals     AiTradeProposal[]
  academyProgress      AcademyProgress[]
  autoScalpConfig      AutoScalpConfig?
  priceAlerts          PriceAlert[]
  weeklyReviews        AiWeeklyJournalReview[]
  dailyReviews         AiDailyJournalReview[]
  tradeReviews         AiTradeReview[]
  moodCheckins         MoodCheckin[]
  tradingGoals         TradingGoal[]
  missionClaims        UserMissionClaim[]
  articleChatMessages  ArticleChatMessage[]
  journalChatMessages  JournalChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserFollow {
  id          String @id @default(cuid())
  followerId  String
  followingId String
  follower    User   @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model ForumCategory {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  threads     ForumThread[]
}

model ForumThread {
  id         String        @id @default(cuid())
  categoryId String
  authorId   String
  title      String
  slug       String
  hidden     Boolean       @default(false)
  isPinned   Boolean       @default(false)
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author     User          @relation(fields: [authorId], references: [id])
  posts      ForumPost[]
  reports    ForumReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
}

model ForumPost {
  id       String        @id @default(cuid())
  threadId String
  authorId String
  body     String
  hidden   Boolean       @default(false)
  thread   ForumThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author   User          @relation(fields: [authorId], references: [id])
  reports  ForumReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Signal {
  id            String             @id @default(cuid())
  authorId      String
  symbol        String
  direction     String
  /// Raw MT5 order type (e.g. BUY, SELL, BUY_LIMIT, SELL_STOP) — used to mirror pending
  /// orders as pending orders (not market fills) on copy-trade followers. Null for
  /// manually-created signals (treated as an immediate market entry).
  orderType     String?
  entry         Float
  stopLoss      Float?
  takeProfit    Float?
  takeProfit2   Float?
  takeProfit3   Float?
  /// Author's own lot size, only populated for signals synced from the MT5 bridge —
  /// used by CopyTrade RATIO mode to size a follower's trade as a % of this lot.
  lotSize       Float?
  tier          SignalTier         @default(FREE)
  status        SignalStatus       @default(ACTIVE)
  /// Snapshot of author's copyTradingPaused at creation time — never re-evaluated later, so
  /// toggling copyTradingPaused doesn't retroactively change which past signals are copyable
  excludedFromCopy Boolean            @default(false)
  notes         String?
  /// Thời điểm đóng lệnh (khi chuyển khỏi ACTIVE)
  closedAt      DateTime?
  author        User               @relation(fields: [authorId], references: [id])
  comments      SignalComment[]
  reactions     SignalReaction[]
  images        SignalImage[]
  editLogs      SignalEditLog[]
  notifications Notification[]
  pinnedBy      UserPinnedSignal[]
  mt5Link       Mt5SignalLink?
  copiedJournals TradeJournal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SignalEditLog {
  id        String   @id @default(cuid())
  signalId  String
  userId    String
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([signalId, createdAt])
}

enum NotificationKind {
  SIGNAL_NEW
  SIGNAL_WIN
  SIGNAL_LOSS
  USER_FOLLOWED
  STREAK_REMINDER
  PRICE_ALERT
  JOURNAL_REVIEW
  SCREENER_ALERT
  MT5_AUTO_CLOSE
  CALENDAR_ACTUAL_SIGNAL
  TECHNICAL_RATING_SIGNAL
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  kind        NotificationKind @default(SIGNAL_NEW)
  /// SIGNAL_NEW: trùng signalId; USER_FOLLOWED: "f:{followerId}"
  dedupeKey   String
  signalId    String?
  /// Người follow (chỉ dùng khi kind = USER_FOLLOWED)
  actorUserId String?
  /// Chi tiết hiển thị riêng theo kind, VD TECHNICAL_RATING_SIGNAL:
  /// { symbol, signal: "buy"|"sell", score4h, score1d }
  meta        Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user   User    @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  signal Signal? @relation(fields: [signalId], references: [id], onDelete: Cascade)
  actor  User?   @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model SignalImage {
  id        String @id @default(cuid())
  signalId  String
  url       String
  sortOrder Int    @default(0)

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([signalId, sortOrder])
}

model SignalComment {
  id       String  @id @default(cuid())
  signalId String
  authorId String
  body     String
  hidden   Boolean @default(false)

  signal  Signal        @relation(fields: [signalId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reports ForumReport[]

  createdAt DateTime @default(now())

  @@index([signalId, createdAt])
}

enum ReactionType {
  LIKE
  DISLIKE
}

model SignalReaction {
  id       String       @id @default(cuid())
  signalId String
  userId   String
  type     ReactionType

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([signalId, userId])
}

enum TradeResult {
  WIN
  LOSS
  BREAKEVEN
  PENDING
}

enum TradingPlanBias {
  BULLISH
  BEARISH
  RANGE
  WAIT
}

model TradeJournal {
  id         String      @id @default(cuid())
  userId     String
  symbol     String
  direction  String
  entry      Float
  stopLoss   Float?
  takeProfit Float?
  exitPrice  Float?
  lotSize    Float?
  result     TradeResult @default(PENDING)
  pnl        Float?
  /// Max adverse / favorable excursion in account currency — the worst and best
  /// floating P/L the position ever showed while open, sampled from MT5 bridge
  /// heartbeats and finalised at close. Only populated for MT5-linked trades.
  maeProfit  Float?
  mfeProfit  Float?
  notes      String?
  setup      String?
  emotion    String?
  /// Self-reported process mistakes on this trade (fixed catalog in
  /// src/lib/journal/mistakes.ts). Used for the "cost of mistakes" ranking.
  mistakes   String[]    @default([])
  imageUrl   String?

  // Đánh dấu trader bấm "vẫn lưu"/"vẫn tiếp tục" để bỏ qua guard khi log lệnh này —
  // dùng để tính stat "lần bỏ qua cảnh báo" trong Journal Advanced Stats.
  overrodeDailyLimit      Boolean @default(false)
  overrodeLossStreakGuard Boolean @default(false)

  copiedFromSignalId String?
  copiedFromSignal   Signal?  @relation(fields: [copiedFromSignalId], references: [id], onDelete: SetNull)

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mt5Link  Mt5SignalLink?
  aiReview AiTradeReview?

  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, openedAt])
  @@index([copiedFromSignalId])
}

/// Nhật ký cảm xúc: 1 ghi chú mỗi ngày, ghi lại trạng thái tâm lý và lý do ra quyết định vào lệnh.
model EmotionDiaryEntry {
  id     String   @id @default(cuid())
  userId String
  date   DateTime
  note   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

/// Bài học trader tự ghi lại (những điểm cần cải thiện) — kèm 1 ảnh tùy chọn.
model JournalLesson {
  id       String  @id @default(cuid())
  userId   String
  body     String
  imageUrl String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model DailyTradingPlan {
  id             String          @id @default(cuid())
  userId         String
  planDate       DateTime
  watchedSymbols String[]        @default([])
  symbolPlans    Json?
  bias           TradingPlanBias @default(WAIT)
  chartImageUrls String[]        @default([])
  keyLevels      String?
  newsToAvoid    String?
  maxRiskPercent Float?
  maxTrades      Int?
  sessionFocus   String?
  notes          String?
  checkedNews    Boolean         @default(false)
  checkedLevels  Boolean         @default(false)
  checkedRisk    Boolean         @default(false)
  checkedEmotion Boolean         @default(false)
  checkedJournal Boolean         @default(false)
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planDate])
  @@index([userId, planDate])
}

model DirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  readAt      DateTime?
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model ForumReport {
  id                String       @id @default(cuid())
  reporterId        String
  postId            String?
  threadId          String?
  signalCommentId   String?
  copyTradeReviewId String?
  reason            String
  status            ReportStatus @default(OPEN)
  reviewedBy        String?
  reviewNote        String?

  reporter        User             @relation("ForumReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  post            ForumPost?       @relation(fields: [postId], references: [id], onDelete: SetNull)
  thread          ForumThread?     @relation(fields: [threadId], references: [id], onDelete: SetNull)
  signalComment   SignalComment?   @relation(fields: [signalCommentId], references: [id], onDelete: SetNull)
  copyTradeReview CopyTradeReview? @relation(fields: [copyTradeReviewId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([signalCommentId])
  @@index([copyTradeReviewId])
}

model VipAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  userId    String
  action    String
  days      Int
  vipUntil  DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model VipPayment {
  id                String           @id @default(cuid())
  userId            String
  provider          String           @default("PAYPAL")
  providerOrderId   String           @unique
  providerCaptureId String?          @unique
  planKey           String
  amount            String
  currency          String           @default("USD")
  status            VipPaymentStatus @default(CREATED)
  vipUntil          DateTime?
  fulfilledAt       DateTime?
  rawPayload        Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model VipWebhookEvent {
  id              String    @id @default(cuid())
  provider        String    @default("PAYPAL")
  providerEventId String    @unique
  eventType       String
  providerOrderId String?
  processedAt     DateTime?
  rawPayload      Json?
  createdAt       DateTime  @default(now())

  @@index([eventType, createdAt])
  @@index([providerOrderId])
}

model UserFavoriteSymbol {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId, sortOrder])
}

model UserPinnedSignal {
  id        String   @id @default(cuid())
  userId    String
  signalId  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([userId, signalId])
  @@index([userId, sortOrder])
}

model UserDemoChallenge {
  id              String    @id @default(cuid())
  userId          String    @unique
  completedDays   Int[]     @default([])
  completedAt     DateTime?
  rewardGrantedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rewardGrantedAt])
}

enum ClientErrorKind {
  ERROR_BOUNDARY
  GLOBAL_ERROR
  UNHANDLED_REJECTION
}

model UserPageVisit {
  id        String   @id @default(cuid())
  userId    String
  path      String
  fullPath  String
  title     String?
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([path, createdAt])
  @@index([createdAt])
}

model UserClientError {
  id        String          @id @default(cuid())
  userId    String
  path      String
  fullPath  String?
  kind      ClientErrorKind @default(GLOBAL_ERROR)
  message   String
  stack     String?
  digest    String?
  userAgent String?
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([path, createdAt])
  @@index([kind, createdAt])
  @@index([createdAt])
}

model FunnelEvent {
  id          String   @id @default(cuid())
  eventName   String
  visitorId   String?
  userId      String?
  path        String
  fullPath    String?
  locale      String?
  surface     String?
  cta         String?
  destination String?
  reason      String?
  properties  Json?
  referrer    String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventName, createdAt])
  @@index([visitorId, createdAt])
  @@index([userId, createdAt])
  @@index([path, createdAt])
  @@index([createdAt])
}

/// Singleton row (id="default") — which AI provider/model powers all AI features app-wide.
model AiModelSetting {
  id        String   @id @default("default")
  provider  String   @default("deepseek")
  model     String?
  updatedAt DateTime @updatedAt
}

/// Per-job on/off switch for scheduled cron endpoints, keyed by CronJobKey (src/app/[locale]/admin/crons/job-registry.ts). Missing row = enabled (default).
model CronJobSetting {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model AiArticleAutomationSetting {
  id               String    @id @default("default")
  enabled          Boolean   @default(false)
  autoPublish      Boolean   @default(false)
  locale           String    @default("vi")
  seedKeywords     String[]  @default(["forex", "XAUUSD", "gold trading", "EURUSD", "forex news"])
  maxArticlesPerDay Int      @default(1)
  lastRunAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model AiGeneratedArticle {
  id              String          @id @default(cuid())
  slug            String
  locale          String          @default("vi")
  keyword         String
  title           String
  summary         String
  body            String
  metaDescription String
  status          AiArticleStatus @default(DRAFT)
  trendSource     String?
  sourceKeywords  String[]        @default([])
  imageUrl        String?
  imageAlt        String?
  generatedAt     DateTime        @default(now())
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  chatMessages ArticleChatMessage[]

  @@unique([locale, slug])
  @@index([locale, status, publishedAt])
  @@index([keyword, generatedAt])
}

/// Per-user chat history attached to an AI article — lets a reader ask "price
/// already crossed X, what now?" and get the article's original call re-evaluated.
model ArticleChatMessage {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())

  article AiGeneratedArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId, userId, createdAt])
}

/// Single ongoing per-user chat thread in the Journal "AI Chat" tab — loss
/// review, improvement coaching, and pre-trade reference checklists, all in
/// one continuous thread (not split per trade).
model JournalChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Bản ghi singleton — lần đồng bộ lịch kinh tế (FMP) gần nhất.
model CalendarSyncMeta {
  id         String   @id
  lastSyncAt DateTime
  source     String
}

/// Cache sự kiện lịch kinh tế (đồng bộ từ FMP hoặc ghi đè khi fallback).
model EconomicCalendarEvent {
  id         String   @id @default(cuid())
  externalId String   @unique
  timeUtc    DateTime
  currency   String
  title      String
  impact     String
  forecast   String?
  previous   String?
  actual     String?

  @@index([timeUtc])
}

/// Cache nhận định AI trend trong ngày để tránh gọi lại model quá thường xuyên.
model AiTrendCache {
  id            String   @id @default(cuid())
  symbol        String
  locale        String
  schemaVersion String
  trend         Json
  generatedAt   DateTime
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([symbol, locale, schemaVersion])
  @@index([expiresAt])
}

model Mt5Connection {
  id              String    @id @default(cuid())
  userId          String
  name            String    @default("MT5 Bridge")
  tokenHash       String    @unique
  tokenLast4      String
  revokedAt       DateTime?
  lastSeenAt      DateTime?
  accountLogin    String?
  accountServer   String?
  accountName     String?
  accountCompany  String?
  accountCurrency String?
  balance         Float?
  equity          Float?
  margin          Float?
  freeMargin      Float?
  leverage        Int?
  openPositions   Int       @default(0)
  pendingOrders   Int       @default(0)
  lastPositions   Json      @default("[]")
  lastOrders      Json      @default("[]")
  lastTradeHash   String?
  lastSnapshotAt  DateTime?
  lastError       String?
  autoCloseBeforeWeekend    Boolean   @default(false)
  lastAutoCloseTriggeredAt  DateTime?
  autoCloseEndOfDay         Boolean   @default(false)
  lastAutoCloseEodTriggeredAt DateTime?
  closeAllAtBreakeven       Boolean   @default(false)
  scheduledCloseEnabled     Boolean   @default(false)
  scheduledCloseTime        String?
  scheduledCloseTz          String    @default("utc")
  lastScheduledCloseTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots Mt5Snapshot[]
  signalLinks Mt5SignalLink[]
  aiTradeProposals AiTradeProposal[]
  commands Mt5Command[]
  trailingStops TrailingStopConfig[]

  @@index([userId, revokedAt])
  @@index([lastSeenAt])
}

model Mt5Snapshot {
  id           String   @id @default(cuid())
  connectionId String
  account      Json
  positions    Json
  orders       Json     @default("[]")
  receivedAt   DateTime @default(now())

  connection Mt5Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, receivedAt])
}

model Mt5SignalLink {
  id           String        @id @default(cuid())
  connectionId String
  signalId     String        @unique
  mt5Ticket    String
  kind         Mt5SignalKind
  lastProfit   Float?
  /// Running max adverse / favorable excursion (floating P/L extremes) while the
  /// position is open — copied onto the linked TradeJournal when it closes.
  maeProfit    Float?
  mfeProfit    Float?
  lastSeenAt   DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  journalId    String?       @unique

  connection Mt5Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  signal     Signal        @relation(fields: [signalId], references: [id], onDelete: Cascade)
  journal    TradeJournal? @relation(fields: [journalId], references: [id], onDelete: SetNull)

  @@unique([connectionId, mt5Ticket])
  @@index([connectionId, kind])
}

model Mt5Command {
  id                String    @id @default(cuid())
  connectionId      String
  type              String    // CLOSE_POSITION | PARTIAL_CLOSE | MODIFY_POSITION | TRAIL_UPDATE | CANCEL_ORDER | MODIFY_ORDER | CLOSE_ALL | PLACE_BUY | PLACE_SELL | PLACE_BUY_LIMIT | PLACE_SELL_LIMIT | PLACE_BUY_STOP | PLACE_SELL_STOP
  ticket            String?   // null for CLOSE_ALL and PLACE_*
  symbol            String?   // PLACE_* only
  volume            Float?    // PLACE_* and PARTIAL_CLOSE only
  price             Float?    // PLACE_*_LIMIT / PLACE_*_STOP only
  stopLoss          Float?
  takeProfit        Float?
  trailDistancePips Float?    // TRAIL_UPDATE only - EA recomputes SL from live price using this distance
  status            String    @default("PENDING")
  // PENDING | SENT | DONE | ERROR | EXPIRED
  errorMsg          String?
  createdAt         DateTime  @default(now())
  sentAt            DateTime?
  doneAt            DateTime?
  expiresAt         DateTime? // price-sensitive commands are marked EXPIRED instead of dispatched once stale

  connection Mt5Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, status, createdAt])
}

model TrailingStopConfig {
  id           String   @id @default(cuid())
  connectionId String
  ticket       String
  distancePips Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connection Mt5Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, ticket])
}

model AiTradeProposal {
  id           String    @id @default(cuid())
  connectionId String
  userId       String
  symbol       String
  timeframe    String
  direction    String    // "LONG" | "SHORT"
  entry        Float
  stopLoss     Float?
  takeProfit   Float?
  confidence   Int?      // 1-5
  qualityScore Float?    // 0-100
  reasoning    String
  checklist    Json?     // [{label, status, detail}]
  keyLevels    Json?     // {support, resistance}
  lotSize      Float?    // lot size requested by user at confirm time
  status       String    @default("PENDING_REVIEW")
  // PENDING_REVIEW | CONFIRMED | REJECTED | EXECUTED
  createdAt    DateTime  @default(now())
  confirmedAt  DateTime?
  executedAt   DateTime?
  rejectedAt   DateTime?
  signalId     String?
  mt5Ticket    String?

  connection Mt5Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([connectionId, status])
}

model ReferralEvent {
  id           String   @id @default(cuid())
  referrerId   String
  refereeId    String
  rewardDays   Int      @default(7)
  createdAt    DateTime @default(now())

  referrer User @relation("ReferralRewardReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("ReferralRewardReferee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@unique([referrerId, refereeId])
  @@index([referrerId])
  @@index([refereeId])
}

model UserPushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CopyTrade {
  id           String   @id @default(cuid())
  followerId   String
  providerId   String
  token        String   @unique
  mode         CopyTradeMode @default(LOT)
  fixedLot     Float?
  riskPercent  Float?
  // RATIO mode: follower's lot = provider's lot * lotPercent / 100. Requires
  // Signal.lotSize to be known (only set for signals synced from the MT5 bridge).
  lotPercent   Float?
  maxLots      Float?   @default(10)
  // Per-symbol lot overrides for LOT mode — gold/crypto move in far bigger price
  // increments per lot than FX pairs, so a single fixedLot is rarely safe for both.
  // Null falls back to fixedLot.
  xauusdLot    Float?
  btcusdLot    Float?
  isActive     Boolean  @default(true)
  // Provider-side block: distinct from `isActive` (which the follower controls).
  // While true, the follower's EA gets no new signals from this provider, but the
  // subscription (token, mode, lot settings) is preserved so unblocking resumes
  // copying without the follower having to resubscribe.
  blockedByProvider Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  follower User @relation("CopyTradeFollower", fields: [followerId], references: [id], onDelete: Cascade)
  provider User @relation("CopyTradeProvider", fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([followerId, providerId])
  @@index([providerId, isActive])
  @@index([token])
}

// One review per (reviewer, provider) pair — upserted, not appended, so a follower's
// opinion can change over time without spamming the list. Eligibility (reviewer must
// have copied the provider for >= 7 days) is enforced in the server action, not here.
model CopyTradeReview {
  id         String   @id @default(cuid())
  providerId String
  reviewerId String
  rating     Int
  comment    String?
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider User          @relation("CopyTradeReviewProvider", fields: [providerId], references: [id], onDelete: Cascade)
  reviewer User          @relation("CopyTradeReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reports  ForumReport[]

  @@unique([reviewerId, providerId])
  @@index([providerId, hidden])
}

enum CopyTradeMode {
  LOT
  PERCENT
  RATIO
}

model Webinar {
  id          String   @id @default(cuid())
  title       String
  description String?
  hostId      String
  streamUrl   String?
  thumbnailUrl String?
  scheduledAt DateTime
  duration    Int      @default(60)
  status      WebinarStatus @default(SCHEDULED)
  maxAttendees Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  host        User @relation(fields: [hostId], references: [id], onDelete: Cascade)
  registrations WebinarRegistration[]

  @@index([status, scheduledAt])
  @@index([hostId])
}

model WebinarRegistration {
  id         String   @id @default(cuid())
  webinarId  String
  userId     String
  createdAt  DateTime @default(now())

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([webinarId, userId])
  @@index([webinarId])
  @@index([userId])
}

enum WebinarStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model AcademyProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonSlug String
  completed Boolean  @default(false)
  quizScore Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

