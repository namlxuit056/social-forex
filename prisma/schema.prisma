// Social Forex — Prisma schema (Auth.js + community features)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MOD
  ADMIN
}

enum SignalTier {
  FREE
  VIP
}

enum SignalStatus {
  ACTIVE
  CLOSED_WIN
  CLOSED_LOSS
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  bio           String?
  role          UserRole  @default(USER)
  vipUntil      DateTime?

  accounts Account[]
  sessions Session[]

  followingFollows UserFollow[] @relation("UserFollowing")
  followerFollows  UserFollow[] @relation("UserFollowers")

  threads ForumThread[]
  posts   ForumPost[]
  signals Signal[]

  sentMessages     DirectMessage[] @relation("SentMessages")
  receivedMessages DirectMessage[] @relation("ReceivedMessages")
  forumReports     ForumReport[]   @relation("ForumReporter")
  favoriteSymbols  UserFavoriteSymbol[]
  signalComments   SignalComment[]
  signalReactions  SignalReaction[]
  tradeJournals    TradeJournal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserFollow {
  id          String @id @default(cuid())
  followerId  String
  followingId String
  follower    User   @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model ForumCategory {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  threads     ForumThread[]
}

model ForumThread {
  id         String        @id @default(cuid())
  categoryId String
  authorId   String
  title      String
  slug       String
  hidden     Boolean       @default(false)
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author     User          @relation(fields: [authorId], references: [id])
  posts      ForumPost[]
  reports    ForumReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
}

model ForumPost {
  id       String      @id @default(cuid())
  threadId String
  authorId String
  body     String
  hidden   Boolean     @default(false)
  thread   ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author   User        @relation(fields: [authorId], references: [id])
  reports  ForumReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Signal {
  id         String       @id @default(cuid())
  authorId    String
  symbol      String
  direction   String
  entry       Float
  stopLoss    Float?
  takeProfit  Float?
  takeProfit2 Float?
  takeProfit3 Float?
  tier       SignalTier   @default(FREE)
  status     SignalStatus @default(ACTIVE)
  notes      String?
  author     User         @relation(fields: [authorId], references: [id])
  comments   SignalComment[]
  reactions  SignalReaction[]
  images     SignalImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SignalImage {
  id        String @id @default(cuid())
  signalId  String
  url       String
  sortOrder Int    @default(0)

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([signalId, sortOrder])
}

model SignalComment {
  id       String @id @default(cuid())
  signalId String
  authorId String
  body     String

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([signalId, createdAt])
}

enum ReactionType {
  LIKE
  DISLIKE
}

model SignalReaction {
  id       String       @id @default(cuid())
  signalId String
  userId   String
  type     ReactionType

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([signalId, userId])
}

enum TradeResult {
  WIN
  LOSS
  BREAKEVEN
  PENDING
}

model TradeJournal {
  id         String      @id @default(cuid())
  userId     String
  symbol     String
  direction  String
  entry      Float
  stopLoss   Float?
  takeProfit Float?
  exitPrice  Float?
  lotSize    Float?
  result     TradeResult @default(PENDING)
  pnl        Float?
  notes      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  openedAt  DateTime @default(now())
  closedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, openedAt])
}

model DirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  readAt      DateTime?
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model ForumReport {
  id         String       @id @default(cuid())
  reporterId String
  postId     String?
  threadId   String?
  reason     String
  status     ReportStatus @default(OPEN)
  reviewedBy String?
  reviewNote String?

  reporter User        @relation("ForumReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  post     ForumPost?  @relation(fields: [postId], references: [id], onDelete: SetNull)
  thread   ForumThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model VipAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  userId    String
  action    String
  days      Int
  vipUntil  DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model UserFavoriteSymbol {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId, sortOrder])
}

/// Bản ghi singleton — lần đồng bộ lịch kinh tế (FMP) gần nhất.
model CalendarSyncMeta {
  id         String   @id
  lastSyncAt DateTime
  source     String
}

/// Cache sự kiện lịch kinh tế (đồng bộ từ FMP hoặc ghi đè khi fallback).
model EconomicCalendarEvent {
  id         String   @id @default(cuid())
  externalId String   @unique
  timeUtc    DateTime
  currency   String
  title      String
  impact     String
  forecast   String?
  previous   String?
  actual     String?

  @@index([timeUtc])
}
