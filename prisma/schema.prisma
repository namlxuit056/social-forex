  day        DateTime
  /// 23:59:59 giờ VN của ngày (lưu dạng UTC)
  dayEnd     DateTime
  tradeCount Int
  /// AiJournalAnalysis JSON
  analysis   Json
  locale     String   @default("vi")
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId, day])
