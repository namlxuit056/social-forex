/// Mục tiêu giao dịch theo tháng — so target với thực tế trên tab Thống kê.
model TradingGoal {
  id            String   @id @default(cuid())
  userId        String
  /// Ngày đầu tháng, 00:00 UTC — kỳ áp dụng mục tiêu
  month         DateTime
  /// % (0–100)
  targetWinRate Float?
  targetAvgR    Float?
  targetNetPnl  Float?
  targetTrades  Int?
  note          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
  @@index([userId, month])
}

/// Một nhiệm vụ khởi động ("Bảng nhiệm vụ người mới") mà user đã hoàn thành và nhận thưởng XP.
/// Điều kiện hoàn thành được kiểm chứng lại server-side khi claim — bảng này chỉ chống nhận thưởng 2 lần.
model UserMissionClaim {
  id        String   @id @default(cuid())
  userId    String
  missionId String
  xpAwarded Int
  claimedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@index([userId])
}

/// Điểm danh tâm lý 1 chạm mỗi ngày (tách khỏi EmotionDiaryEntry vốn cần note dài).
model MoodCheckin {
  id     String   @id @default(cuid())
  userId String
  /// 00:00 UTC của ngày điểm danh
  day    DateTime
  /// "good" | "ok" | "tired" | "stressed"
  mood   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
  @@index([userId, day])
}

/// Chấm điểm AI cho một lệnh journal ngay khi đóng — phản hồi tức thì thay vì đợi Weekly/Daily Review.
model AiTradeReview {
  id        String   @id @default(cuid())
  userId    String
  tradeId   String   @unique
  /// AiTradeReviewResult JSON
  review    Json
  locale    String   @default("vi")
  createdAt DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade TradeJournal @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ScreenerAlert {
  id              String    @id @default(cuid())
  userId          String
  name            String
  /// JSON conditions matching CustomFilters format
  conditions      Json
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs  ScreenerAlertLog[]

  @@index([userId, isActive])
}

model ScreenerAlertLog {
  id          String   @id @default(cuid())
  alertId     String
  symbol      String
  triggeredAt DateTime @default(now())
  /// Snapshot of matched pair data
  data        Json

  alert ScreenerAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, triggeredAt])
}

/// Tổng kết cuối ngày (cron) cho các tín hiệu kỹ thuật "chắc chắn" đã gửi trong ngày UTC đó.
/// Tuần/tháng tính bằng cách cộng dồn các dòng ngày trong khoảng — không lưu riêng.
model TechnicalRatingDailySummary {
  id           String   @id @default(cuid())
  /// Đầu ngày UTC (00:00) — 1 dòng / ngày.
  day          DateTime @unique
  totalSignals Int
  buySignals   Int
  sellSignals  Int
  /// Số tín hiệu vẫn cùng chiều tại thời điểm cron chạy (cuối ngày) — proxy đơn giản cho
  /// "tín hiệu có giữ được không", KHÔNG phải đánh giá lời/lỗ thực tế (chưa có hạ tầng theo dõi giá).
  heldSignals  Int
  /// [{ symbol, count }] — top symbol theo số lần fire trong ngày.
  topSymbols   Json
  createdAt    DateTime @default(now())
}

model AcademyLesson {
