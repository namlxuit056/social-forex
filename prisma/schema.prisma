  title         String
  summary       String
  body          String    @db.Text
  keywords      String[]
  imageUrl      String?
  quizQuestions Json?
  status        String    @default("DRAFT") // "DRAFT" | "PUBLISHED" | "ARCHIVED"
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([slug, locale])
}
