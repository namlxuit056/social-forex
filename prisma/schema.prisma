// Social Forex — Prisma schema (Auth.js + community features)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MOD
  ADMIN
}

enum SignalTier {
  FREE
  VIP
}

enum SignalStatus {
  ACTIVE
  CLOSED_WIN
  CLOSED_LOSS
  CANCELLED
}

enum VipPaymentStatus {
  CREATED
  CAPTURED
  FULFILLED
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  bio           String?
  role          UserRole  @default(USER)
  vipUntil      DateTime?

  accounts Account[]
  sessions Session[]

  followingFollows UserFollow[] @relation("UserFollowing")
  followerFollows  UserFollow[] @relation("UserFollowers")

  threads ForumThread[]
  posts   ForumPost[]
  signals Signal[]

  sentMessages         DirectMessage[]      @relation("SentMessages")
  receivedMessages     DirectMessage[]      @relation("ReceivedMessages")
  forumReports         ForumReport[]        @relation("ForumReporter")
  favoriteSymbols      UserFavoriteSymbol[]
  signalComments       SignalComment[]
  signalReactions      SignalReaction[]
  tradeJournals        TradeJournal[]
  notifications        Notification[]       @relation("NotificationRecipient")
  notificationsAsActor Notification[]       @relation("NotificationActor")
  signalEditLogs       SignalEditLog[]
  pinnedSignals        UserPinnedSignal[]
  vipPayments          VipPayment[]

  /// Thông báo in-app: tín hiệu từ trader đang follow
  notifySignalFollow       Boolean @default(true)
  /// Thông báo khi có tín hiệu trùng symbol trong watchlist (favorites)
  notifySignalFavoriteSym  Boolean @default(true)
  /// (VIP) Thông báo khi có tín hiệu VIP mới trên nền tảng
  notifySignalVipBroadcast Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserFollow {
  id          String @id @default(cuid())
  followerId  String
  followingId String
  follower    User   @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model ForumCategory {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  threads     ForumThread[]
}

model ForumThread {
  id         String        @id @default(cuid())
  categoryId String
  authorId   String
  title      String
  slug       String
  hidden     Boolean       @default(false)
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author     User          @relation(fields: [authorId], references: [id])
  posts      ForumPost[]
  reports    ForumReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
}

model ForumPost {
  id       String        @id @default(cuid())
  threadId String
  authorId String
  body     String
  hidden   Boolean       @default(false)
  thread   ForumThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author   User          @relation(fields: [authorId], references: [id])
  reports  ForumReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Signal {
  id            String             @id @default(cuid())
  authorId      String
  symbol        String
  direction     String
  entry         Float
  stopLoss      Float?
  takeProfit    Float?
  takeProfit2   Float?
  takeProfit3   Float?
  tier          SignalTier         @default(FREE)
  status        SignalStatus       @default(ACTIVE)
  notes         String?
  /// Thời điểm đóng lệnh (khi chuyển khỏi ACTIVE)
  closedAt      DateTime?
  author        User               @relation(fields: [authorId], references: [id])
  comments      SignalComment[]
  reactions     SignalReaction[]
  images        SignalImage[]
  editLogs      SignalEditLog[]
  notifications Notification[]
  pinnedBy      UserPinnedSignal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SignalEditLog {
  id        String   @id @default(cuid())
  signalId  String
  userId    String
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([signalId, createdAt])
}

enum NotificationKind {
  SIGNAL_NEW
  USER_FOLLOWED
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  kind        NotificationKind @default(SIGNAL_NEW)
  /// SIGNAL_NEW: trùng signalId; USER_FOLLOWED: "f:{followerId}"
  dedupeKey   String
  signalId    String?
  /// Người follow (chỉ dùng khi kind = USER_FOLLOWED)
  actorUserId String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user   User    @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  signal Signal? @relation(fields: [signalId], references: [id], onDelete: Cascade)
  actor  User?   @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model SignalImage {
  id        String @id @default(cuid())
  signalId  String
  url       String
  sortOrder Int    @default(0)

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([signalId, sortOrder])
}

model SignalComment {
  id       String  @id @default(cuid())
  signalId String
  authorId String
  body     String
  hidden   Boolean @default(false)

  signal  Signal        @relation(fields: [signalId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reports ForumReport[]

  createdAt DateTime @default(now())

  @@index([signalId, createdAt])
}

enum ReactionType {
  LIKE
  DISLIKE
}

model SignalReaction {
  id       String       @id @default(cuid())
  signalId String
  userId   String
  type     ReactionType

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([signalId, userId])
}

enum TradeResult {
  WIN
  LOSS
  BREAKEVEN
  PENDING
}

model TradeJournal {
  id         String      @id @default(cuid())
  userId     String
  symbol     String
  direction  String
  entry      Float
  stopLoss   Float?
  takeProfit Float?
  exitPrice  Float?
  lotSize    Float?
  result     TradeResult @default(PENDING)
  pnl        Float?
  notes      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, openedAt])
}

model DirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  readAt      DateTime?
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model ForumReport {
  id              String       @id @default(cuid())
  reporterId      String
  postId          String?
  threadId        String?
  signalCommentId String?
  reason          String
  status          ReportStatus @default(OPEN)
  reviewedBy      String?
  reviewNote      String?

  reporter      User           @relation("ForumReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  post          ForumPost?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  thread        ForumThread?   @relation(fields: [threadId], references: [id], onDelete: SetNull)
  signalComment SignalComment? @relation(fields: [signalCommentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([signalCommentId])
}

model VipAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  userId    String
  action    String
  days      Int
  vipUntil  DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model VipPayment {
  id                String           @id @default(cuid())
  userId            String
  provider          String           @default("PAYPAL")
  providerOrderId   String           @unique
  providerCaptureId String?          @unique
  planKey           String
  amount            String
  currency          String           @default("USD")
  status            VipPaymentStatus @default(CREATED)
  vipUntil          DateTime?
  fulfilledAt       DateTime?
  rawPayload        Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model VipWebhookEvent {
  id              String    @id @default(cuid())
  provider        String    @default("PAYPAL")
  providerEventId String    @unique
  eventType       String
  providerOrderId String?
  processedAt     DateTime?
  rawPayload      Json?
  createdAt       DateTime  @default(now())

  @@index([eventType, createdAt])
  @@index([providerOrderId])
}

model UserFavoriteSymbol {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId, sortOrder])
}

model UserPinnedSignal {
  id        String   @id @default(cuid())
  userId    String
  signalId  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([userId, signalId])
  @@index([userId, sortOrder])
}

/// Bản ghi singleton — lần đồng bộ lịch kinh tế (FMP) gần nhất.
model CalendarSyncMeta {
  id         String   @id
  lastSyncAt DateTime
  source     String
}

/// Cache sự kiện lịch kinh tế (đồng bộ từ FMP hoặc ghi đè khi fallback).
model EconomicCalendarEvent {
  id         String   @id @default(cuid())
  externalId String   @unique
  timeUtc    DateTime
  currency   String
  title      String
  impact     String
  forecast   String?
  previous   String?
  actual     String?

  @@index([timeUtc])
}

/// Cache nhận định AI trend trong ngày để tránh gọi lại model quá thường xuyên.
model AiTrendCache {
  id            String   @id @default(cuid())
  symbol        String
  locale        String
  schemaVersion String
  trend         Json
  generatedAt   DateTime
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([symbol, locale, schemaVersion])
  @@index([expiresAt])
}
