# PostgreSQL — chạy: docker compose up -d
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialforex"

# Auth.js — generate: openssl rand -base64 32
AUTH_SECRET=""

AUTH_TRUST_HOST="true"

# Production / Vercel: URL công khai chính xác (vd https://your-app.vercel.app hoặc domain thật), trùng host với trình duyệt — giúp session/cookie và API upload nhận đúng đăng nhập
AUTH_URL=""

# Canonical site URL (sitemap, Open Graph, /llms.txt và prompt “AI assistant” trên /start). Nếu trống, code fallback https://social-forex.vercel.app — khi có domain riêng hãy set URL production tại đây
NEXT_PUBLIC_SITE_URL="https://social-forex.vercel.app"

# Optional: POST /api/admin/vip — kích hoạt VIP theo email
ADMIN_SECRET=""

# --- Giai đoạn B: Tỷ giá (Quotes) ---
# massive | yahoo | mock  — mặc định: massive nếu có MASSIVE_API_KEY, ngược lại yahoo
QUOTES_PROVIDER=""

# Massive (https://massive.com) — Forex, crypto, indices real-time data
MASSIVE_API_KEY=""

# Alpha Vantage — nếu tích hợp provider riêng (giới hạn free tier)
ALPHA_VANTAGE_API_KEY=""

# --- Lịch kinh tế ---
# investing | fmp | sample — mặc định: investing (free, không cần key)
CALENDAR_PROVIDER="investing"

# Financial Modeling Prep — chỉ dùng nếu CALENDAR_PROVIDER=fmp (cần gói trả phí)
FMP_API_KEY=""

# TTL cache đồng bộ lịch FMP (phút)
CALENDAR_SYNC_TTL_MINUTES="45"

# Khung giờ “bối cảnh tin” trên trang chi tiết signal (1–168, mặc định 24)
NEWS_CONTEXT_HOURS="24"

# --- AI Trading Suggestions ---
# groq | openai — mặc định: groq (free, cực nhanh)
AI_PROVIDER="groq"

# Groq (https://console.groq.com) — free 1000 req/ngày
GROQ_API_KEY=""

# OpenAI — dùng nếu AI_PROVIDER=openai
OPENAI_API_KEY=""

# --- Signal images (Vercel Blob)
# Store ví dụ: social-forex-blob — token READ/WRITE lấy trong Vercel → Storage → Blob (không dùng read-only).
# Giá trị token không bọc ngoặc kép thừa; sửa .env cần restart `next dev`.
BLOB_READ_WRITE_TOKEN=""
# Thư mục object trong store (mặc định signal → đường dẫn signal/{userId}/…)
BLOB_UPLOAD_PREFIX="signal"

# --- TradingView (widget embed trên Dashboard / Chart) ---
# Symbol hiển thị, ví dụ OANDA:EURUSD, FX:EURUSD
NEXT_PUBLIC_TRADINGVIEW_SYMBOL="OANDA:EURUSD"

# --- Affiliate Exness (trang chủ CTA) — để trống = dùng URL mặc định trong code
# NEXT_PUBLIC_EXNESS_AFFILIATE_URL="https://one.exnessonelink.com/a/nmm9gkpy67"
